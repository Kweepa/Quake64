    12                          
    13                          VIEW_COL	= 4
    14                          VIEW_ROW	= 0
    15                          VIEW_W		= 32
    16                          VIEW_H		= 16
    17                          
    18                          ; PAL text starts at raster 51 (YSCROLL=3). Top 8 char rows → last line 114.
    19                          ; Plan said "line 100"; hardware mid-window is 114/115.
    20                          RASTER_SPLIT	= 114
    21                          RASTER_HUD	= 179			; 51 + 128
    22                          RASTER_TOP	= 50
    23                          
    24                          D018_A_TOP	= $04			; matrix $C000, charset $D000
    25                          D018_A_BOT	= $06			; matrix $C000, charset $D800
